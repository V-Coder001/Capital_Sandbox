{
  "name": "capital-sandbox",
  "version": "0.1.0",
  "description": "Localhost-Multiplayer-Wirtschaftssimulation (Node.js + Socket.io + Canvas)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "gateway": "node gateway.js",
    "desktop": "electron desktop/main.js",
    "desktop:build": "electron-builder",
    "desktop:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "io.capitalsandbox.game",
    "productName": "Capital Sandbox",
    "copyright": "Capital Sandbox",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "desktop/build"
    },
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "files": [
      "desktop/**",
      "server.js",
      "statisch.js",
      "public/**",
      "maps/**",
      "package.json",
      "!**/*.map",
      "!marketing/**",
      "!tools/**",
      "!build/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "public/assets/video/**",
      "public/assets/music/**",
      "public/assets/ambient/**",
      "public/assets/sfx/**"
    ],
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Game",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "V-Coder001",
      "repo": "Capital_Sandbox",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "express": "^4.19.0",
    "http-proxy": "^1.18.1",
    "peerjs": "^1.5.5",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.8.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "author": "V-Coder001",
  "repository": {
    "type": "git",
    "url": "https://github.com/V-Coder001/Capital_Sandbox.git"
  }
}
